; Bootloader occupies the first 32 KiB of the 512 KiB GD32F303ZE flash.
; Application Slot A starts at 0x08008000; Slot B starts at 0x08040000.

LR_IROM1 0x08000000 0x00008000
{
    ER_IROM1 0x08000000 0x00008000
    {
        *.o (RESET, +First)
        *(InRoot$$Sections)
        .ANY (+RO)
        .ANY (+XO)
    }

    RW_IRAM1 0x20000000 0x00010000
    {
        .ANY (+RW +ZI)
    }
}
